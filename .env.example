# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Closed preview mode. Use a long random token and share links as /new-project?beta=YOUR_TOKEN.
# Keep both values disabled/empty in Production after the private test ends.
NEXT_PUBLIC_ROOMAI_BETA_MODE=false
ROOMAI_BETA_ACCESS_TOKEN=

# Supabase (Project Settings -> API / Connect)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers -> API keys)
# Keep false on Production until Supabase SQL, Stripe webhook and a sandbox purchase are verified.
ROOMAI_PUBLIC_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_WEEKLY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Optional add-on prices; credit packs are hidden while the subscription tariff is tested.
STRIPE_PRICE_PACK_10=
STRIPE_PRICE_PACK_30=
STRIPE_PRICE_PACK_100=

# OpenAI API (server only — never expose publicly)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Affiliate placeholders
AMAZON_ASSOCIATE_TAG=
WALMART_AFFILIATE_ID=
TEMU_AFFILIATE_ID=
IKEA_AFFILIATE_ID=
